# /etc/systemd/system/kiosk.service  -- wall display kiosk on the Pi 4
#
# `cage` is a Wayland compositor that runs EXACTLY ONE fullscreen application. No window manager,
# no taskbar, no alt-tab, nothing behind the browser. If Chromium exits, cage exits and systemd
# restarts it. That is a much stronger guarantee than "a desktop with the panel hidden", where a
# stray tap can still surface a menu -- which is what the user explicitly asked to avoid.
#
# Runs on tty1 as the login user (not root): Chromium refuses to run as root, and the user is
# already in `video`/`render`/`input`, which is what cage needs for DRM and libinput.
#
# --disable-accelerated-video-decode: HARDWARE DECODE IS DELIBERATELY OFF. The Pi 4 has ONE video
# decoder block, and five simultaneous H.264 sessions make it hiccup. Measured 2026-08-18 at 1s
# resolution over 4 minutes, same tiles, same everything else:
#
#     hardware decode   west_gate 10/239s frozen (4.2%), driveway 5/239s (2.1%)  -- 15 skips
#     software decode   west_gate  0/239s frozen (0.0%), driveway 0/239s (0.0%)  --  0 skips
#
# Software decode is also CHEAPER here: 30.4% of 4 cores against 31.9%. These sub-streams are small
# enough that the offload buys nothing and costs smoothness. Do not "fix" this by re-enabling it.
#
# NOTE: a 6-second sampler saw almost nothing (0.2%) because it only detects stalls lasting >=6s.
# These skips are ~1s. Measure at 1s resolution or they are invisible -- see tools/fine.sh.
# Better still, use tools/video-stats.py, which reads the browser's own dropped-frame counters.
#
# GPU flags (--ignore-gpu-blocklist / --enable-gpu-rasterization / --enable-zero-copy) were TRIED
# AND DROPPED: with healthy power they made no difference (driveway 9.1% without vs 10.0% with,
# inside run-to-run variance). They only looked helpful while the Pi was browning out.
#
# THE REMAINING LIMIT is Chromium's renderer thread, pegged at ~98% of one core. It composites in a
# single thread and five live video layers saturate one Pi 4 core. Output resolution barely matters
# (1920x1080 measured no better), so this is single-core compute, not pixels and not decode.
#
# Install with wallpi-stack/setup-kiosk.sh.

[Unit]
Description=Wall display kiosk (cage + Chromium)
# Wait for the network: the dashboard is remote, and Chromium caches a failed load as a blank page
# rather than retrying, so starting early produces a permanently dead screen.
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
Type=simple
User=naseer
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
# Chromium tries to talk to a keyring for saved passwords; on a headless Lite box there is none,
# and it blocks on the prompt forever. basic = store in the profile, no keyring.
Environment=CHROMIUM_FLAGS=

ExecStart=/usr/bin/cage -d -- /usr/bin/chromium \
    --kiosk \
    --disable-accelerated-video-decode \
    --ozone-platform=wayland \
    --enable-features=UseOzonePlatform \
    --password-store=basic \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=Translate \
    --check-for-update-interval=31536000 \
    --autoplay-policy=no-user-gesture-required \
    --user-data-dir=/home/naseer/.kiosk-profile \
    KIOSK_URL_PLACEHOLDER

# A wall display must heal itself: nobody is going to notice a dead screen at 3 a.m.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
