# Orin Frigate stack -- copy to /opt/stack/.env on the Orin and fill in.
# NEVER commit the real .env. Secrets are entered with the set-*.sh scripts so they
# never appear on screen, in shell history, or in any log.
#
# Every value here already exists in masn's /opt/stack/.env. Use tools/sync-secrets-from-masn.sh
# to copy them across without printing them, or set each one by hand.

# Reolink camera admin password (same cameras, same password as masn)
FRIGATE_RTSP_PASSWORD=

# The MQTT broker stays on masn -- this is masn's LAN IP, the address its mosquitto
# binds explicitly alongside 127.0.0.1.
MASN_LAN_IP=
MQTT_USER=
MQTT_PASSWORD=

# NAS recordings share, least-privilege `frigate` account (same as masn)
NAS_IP=
NAS_FRIGATE_SHARE=
NAS_FRIGATE_SMB_USER=
NAS_FRIGATE_SMB_PASSWORD=

# SHADOW-ONLY subdirectory inside NAS_FRIGATE_SHARE. Keeps this instance's recordings off
# masn's while both run. MUST ALREADY EXIST on the NAS -- SMB will not create it and the
# mount fails outright. Delete the directory after cutover.
NAS_FRIGATE_SHADOW_DIR=orin-shadow

# Frigate+ API key. Same subscription; submitting from either instance is fine.
PLUS_API_KEY=

TZ=

# The Orin's own LAN IP. Used to bind the UNAUTHENTICATED :5000 API to this interface only --
# never 0.0.0.0, which would also publish it on the tailnet. Home Assistant on masn needs it
# (rest_command.frigate_get_event + the Frigate integration). Also gated to masn's IP by a host
# firewall rule; the binding alone is not the control.
ORIN_LAN_IP=192.168.50.200
