# Copy to .env and fill real values. Then: chmod 600 .env. NEVER commit real secrets.

TZ=America/Toronto

# --- Postgres (HA recorder DB) ---
PG_USER=hauser
PG_PASSWORD=CHANGE_ME_strong_random

# --- Mosquitto MQTT user (shared by HA + Zigbee2MQTT) ---
# setup-masn.sh writes this into mosquitto/config/passwd via mosquitto_passwd.
MQTT_USER=mqtt
MQTT_PASSWORD=CHANGE_ME_strong_random

# --- Frigate (Phase 3) ---
FRIGATE_RTSP_PASSWORD=CHANGE_ME_strong_random

# --- Home Assistant API (automations-as-code workflow) ---
# Long-lived access token: HA > Profile > Security > Long-lived access tokens. Set via set-ha-token.sh.
HA_TOKEN=

# --- Host networking ---
# masn's LAN IP. Mosquitto publishes a second listener on THIS address (in addition to
# loopback) so a Frigate running on another box -- the Jetson Orin -- can reach the broker.
# Must be the real LAN address, not 0.0.0.0: that would also expose it on the tailnet.
MASN_LAN_IP=192.168.x.x

# --- NAS (SMB / UGOS shared folders) -- PER-SHARE least-privilege accounts ---
# Share names = the UGOS shared-folder names (accessed as //NAS_IP/<share>).
NAS_IP=192.168.x.x
# 'frigate' NAS user: Frigate recordings share ONLY (rw). Isolates camera footage -- if Frigate
# is compromised its credential unlocks nothing else.
NAS_FRIGATE_SMB_USER=frigate
NAS_FRIGATE_SMB_PASSWORD=CHANGE_ME
NAS_FRIGATE_SHARE=frigate
# 'masn' NAS user: backups + media (rw).
NAS_MASN_SMB_USER=masn
NAS_MASN_SMB_PASSWORD=CHANGE_ME
NAS_BACKUPS_SHARE=backup
NAS_MEDIA_SHARE=media
