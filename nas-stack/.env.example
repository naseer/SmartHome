# Copy to nas-stack/.env and fill. chmod 600. NEVER commit real secrets (.env is gitignored).

# Tailscale auth key -- admin console > Settings > Keys > Generate auth key.
# Recommended: Reusable OFF, Ephemeral OFF, and pre-authorize the tag:media tag
# (Tagged so the ACL can target it). Looks like: tskey-auth-xxxxxxxxxxxx
TS_AUTHKEY=tskey-REPLACE_ME
